// Honey Badger Outfits — database schema
// NOTE: This schema is written to match the product spec's data model
// (users, catalog, variants, inventory, offers, orders, returns, reviews).
// It is NOT yet connected to a live Postgres instance in this build —
// see README.md "What's real vs. stubbed" for details on how the app
// currently runs against a JSON file store instead.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  STAFF
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  name          String?
  phone         String?
  role          Role      @default(CUSTOMER)
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())

  addresses     Address[]
  orders        Order[]
  wishlist      WishlistItem[]
  reviews       Review[]
  returns       ReturnRequest[]
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  pincode    String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Category {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  parentId    String?
  parent      Category?     @relation("CategoryToCategory", fields: [parentId], references: [id])
  children    Category[]    @relation("CategoryToCategory")
  sortOrder   Int           @default(0)
  active      Boolean       @default(true)
  products    Product[]
}

enum ProductStatus {
  DRAFT
  ACTIVE
  SOLD_OUT
  COMING_SOON
  LIMITED_STOCK
  HIDDEN
}

model Product {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id])
  shortDesc     String?
  description   String?
  brand         String         @default("Honey Badger")
  sku           String         @unique
  mrp           Int
  price         Int
  costPrice     Int?
  status        ProductStatus  @default(DRAFT)
  specs         Json?          // category-specific spec fields
  seoTitle      String?
  seoDescription String?
  seoSlug       String?
  lowStockThreshold Int        @default(10)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  images        ProductImage[]
  variants      ProductVariant[]
  reviews       Review[]
  wishlistedBy  WishlistItem[]
  orderItems    OrderItem[]
}

model ProductImage {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  url        String
  colorName  String?
  sortOrder  Int      @default(0)
  isVideo    Boolean  @default(false)
}

model ProductVariant {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id])
  colorName  String
  colorHex   String?
  size       String
  sku        String    @unique
  inventory  Inventory?
  orderItems OrderItem[]

  @@unique([productId, colorName, size])
}

model Inventory {
  id              String   @id @default(cuid())
  variantId       String   @unique
  variant         ProductVariant @relation(fields: [variantId], references: [id])
  quantity        Int      @default(0)
  reserved        Int      @default(0)
  updatedAt       DateTime @updatedAt

  transactions    InventoryTransaction[]
}

model InventoryTransaction {
  id            String   @id @default(cuid())
  inventoryId   String
  inventory     Inventory @relation(fields: [inventoryId], references: [id])
  previousQty   Int
  newQty        Int
  reason        String
  actor         String?
  createdAt     DateTime @default(now())
}

enum OfferType {
  PERCENTAGE
  FIXED
  BUY_X_GET_Y
  COMBO
  FREE_SHIPPING
}

model Offer {
  id             String    @id @default(cuid())
  name           String
  type           OfferType
  config         Json      // e.g. { comboSize: 3, comboPrice: 999, eligibleTag: "combo-eligible" }
  couponCode     String?   @unique
  minCartValue   Int?
  usageLimit     Int?
  perCustomerLimit Int?
  stackable      Boolean   @default(false)
  priority       Int       @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
}

enum OrderStatus {
  PLACED
  PAYMENT_CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  PAYMENT_FAILED
}

enum PaymentMethod {
  RAZORPAY
  COD
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  status          OrderStatus   @default(PLACED)
  paymentMethod   PaymentMethod
  paymentId       String?
  subtotal        Int
  discount        Int           @default(0)
  shippingFee     Int           @default(0)
  codFee          Int           @default(0)
  total           Int
  addressSnapshot Json
  couponCode      String?
  createdAt       DateTime      @default(now())

  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  shipment        Shipment?
  returns         ReturnRequest[]
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  quantity    Int
  unitPrice   Int
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id])
  status    OrderStatus
  note      String?
  actor     String?
  createdAt DateTime    @default(now())
}

model Shipment {
  id                String   @id @default(cuid())
  orderId           String   @unique
  order             Order    @relation(fields: [orderId], references: [id])
  courierName       String?
  awbNumber         String?
  trackingUrl       String?
  shippedAt         DateTime?
  expectedDelivery  DateTime?
}

enum ReturnStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PICKUP_PENDING
  RECEIVED
  REPLACEMENT_PROCESSING
  REPLACEMENT_SHIPPED
  COMPLETED
}

model ReturnRequest {
  id          String        @id @default(cuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id])
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  reason      String
  description String?
  status      ReturnStatus  @default(REQUESTED)
  createdAt   DateTime      @default(now())

  images      ReturnImage[]
}

model ReturnImage {
  id        String   @id @default(cuid())
  returnId  String
  returnReq ReturnRequest @relation(fields: [returnId], references: [id])
  url       String
}

model Review {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  rating      Int
  title       String?
  body        String?
  verified    Boolean  @default(false)
  approved    Boolean  @default(false)
  createdAt   DateTime @default(now())

  images      ReviewImage[]
}

model ReviewImage {
  id        String  @id @default(cuid())
  reviewId  String
  review    Review  @relation(fields: [reviewId], references: [id])
  url       String
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model AdminSettings {
  id                    String  @id @default("singleton")
  brandName             String  @default("Honey Badger")
  supportEmail          String?
  supportPhone          String?
  whatsappNumber        String?
  codFee                Int     @default(30)
  shippingFee           Int     @default(0)
  freeShippingThreshold Int     @default(799)
  lowStockThreshold     Int     @default(10)
  announcementText      String?
  returnPolicyText      String  @default("Returns and replacements are available only for products received damaged.")
}
